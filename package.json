{
  "name": "default-electron-app-template",
  "productName": "Default Electron App",
  "version": "0.1.0",
  "main": "dist-electron/main/index.js",
  "description": "Template for modular Electron desktop applications.",
  "author": "devLilic13",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.20.0 <25",
    "npm": ">=10"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && electron-builder",
    "init:starter": "node scripts/init/run.ts",
    "validate:release": "node scripts/validate-release.mjs",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.11",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-electron": "^1.2.0",
    "vitest": "^4.1.12"
  }
}
