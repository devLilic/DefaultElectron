{
  "name": "default-electron-app-template",
  "productName": "Default Electron App",
  "version": "0.1.0",
  "main": "dist-electron/main/index.js",
  "description": "Template for modular Electron desktop applications.",
  "author": "devLilic13",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=22.18.0 <23", "npm": ">=10" },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && electron-builder",
    "init:starter": "node --experimental-strip-types scripts/init/run.ts",
    "validate:release": "node scripts/validate-release.mjs",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:unit:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.25",
    "postcss-import": "^16.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^4.1.10"
  }
}
